NODE_ENV=development
PORT=5000
# MongoDB Atlas: Database > Connect > Drivers se apni connection string yahan .env mein paste karein (is example file mein kabhi nahi)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/learning_hub
# Kam az kam 32 characters. Banane ke liye: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-generate-a-long-random-string
# Local: http://localhost:5173   |   Deploy ke baad: apna Vercel URL (bina aakhri slash ke)
CLIENT_ORIGIN=http://localhost:5173

# Video upload (optional): ek video ki hadd aur sab uploaded videos ki kul hadd (MB). Free Atlas mein 512 MB jagah hoti hai.
UPLOAD_MAX_MB=25
UPLOAD_TOTAL_MAX_MB=300

# Server start par lessons/quizzes kam hon to khud seed kar do (band karne ke liye false)
AUTO_SEED=true
