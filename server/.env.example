NODE_ENV=development
PORT=5000
# MongoDB Atlas: Database > Connect > Drivers se apni connection string yahan .env mein paste karein (is example file mein kabhi nahi)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/learning_hub
# Kam az kam 32 characters. Banane ke liye: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-generate-a-long-random-string
# Local: http://localhost:5173   |   Deploy ke baad: apna Vercel URL (bina aakhri slash ke)
CLIENT_ORIGIN=http://localhost:5173

# Video upload (optional): ek video ki hadd aur sab uploaded videos ki kul hadd (MB). Free Atlas mein 512 MB jagah hoti hai.
UPLOAD_MAX_MB=25
UPLOAD_TOTAL_MAX_MB=300

# Server start par lessons/quizzes kam hon to khud seed kar do (band karne ke liye false)
AUTO_SEED=true

# Proxy hop ki ginti (rate limit ke liye). Render: 1. Vercel backend: 2
TRUST_PROXY_HOPS=1

# Email (password reset OTP aur students ko insights se email). Gmail ke liye: 2-Step Verification on karein, phir
# myaccount.google.com/apppasswords se "App password" banayen aur SMTP_PASS mein wo daalen (asli Gmail password nahi).
# Khali chhoden to development mein email console mein print hoti hai (OTP wahin dikh jata hai); production mein email nahi jati.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=Learning Hub <your.email@gmail.com>

# Roz khud chalne wali "nudge" emails (Insights mein on/off hoti hain). Vercel Cron har din 04:00 UTC (subah 9 baje Pakistan)
# /api/cron/nudges chalata hai. CRON_SECRET koi bhi lamba random text hai (kam az kam 16 harf); Vercel ye khud bhej deta hai.
CRON_SECRET=change-me-to-a-long-random-text
# Ek din mein zyada se zyada itni automatic emails (Gmail ki roz ki hadd ke liye)
AUTO_NUDGE_MAX=100
