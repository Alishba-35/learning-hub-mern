{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{src/seed/**,src/assets/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/nudges",
      "schedule": "0 4 * * *"
    }
  ]
}
